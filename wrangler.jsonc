// This file is public (GPL repo). It holds configuration only — never secrets.
// Secrets (TOKEN_SECRET, webhook URLs) go in `wrangler secret put` / .dev.vars.
// Resource ids (D1 database_id) are identifiers, not secrets.
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "shogi",
	"compatibility_date": "2026-09-25",
	"compatibility_flags": ["nodejs_compat"],
	// Worker entry: exports the Durable Objects, routes the online API first,
	// then hands everything else to TanStack Start (docs/PLAN.md §2.1).
	"main": "src/server.ts",
	"assets": {
		// Prerendered pages are written as `<path>.html` (autoSubfolderIndex: false),
		// so `/online` is served from online.html and `/online/` 307s to `/online`.
		"html_handling": "auto-trailing-slash"
	},
	// Workers Caching: cached Worker responses are served without running the
	// Worker. src/server.ts forces `no-store` on anything that does not opt in.
	"cache": { "enabled": true },
	"observability": {
		"enabled": true,
		"head_sampling_rate": 0.1
	},
	"upload_source_maps": true,
	"vars": {
		// Seconds a random-match seeker waits before being offered a COM game.
		"BOT_FALLBACK_SECONDS": "30"
	},
	"durable_objects": {
		"bindings": [
			{ "name": "MATCH_ROOM", "class_name": "MatchRoom" },
			{ "name": "MATCHMAKER", "class_name": "Matchmaker" }
		]
	},
	"migrations": [{ "tag": "v1", "new_sqlite_classes": ["MatchRoom", "Matchmaker"] }],
	// Coarse per-IP limits per endpoint group (Cloudflare Rate Limiting: per data
	// centre, eventually consistent). Hard limits live in D1. Schools put many
	// players behind one IP, so play traffic is allowed generously.
	"ratelimits": [
		{ "name": "RL_CREATE", "namespace_id": "1001", "simple": { "limit": 10, "period": 60 } },
		{ "name": "RL_JOIN", "namespace_id": "1002", "simple": { "limit": 30, "period": 60 } },
		{ "name": "RL_QUEUE", "namespace_id": "1003", "simple": { "limit": 10, "period": 60 } },
		{ "name": "RL_STATS", "namespace_id": "1004", "simple": { "limit": 30, "period": 60 } },
		{ "name": "RL_BOT_RESULT", "namespace_id": "1005", "simple": { "limit": 20, "period": 60 } },
		{ "name": "RL_PLAY", "namespace_id": "1006", "simple": { "limit": 1200, "period": 60 } }
	],
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "shogi",
			"database_id": "d97c5cc4-e92d-42c2-a999-4e6f291d267f",
			"migrations_dir": "migrations"
		}
	]
}
