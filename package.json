{
	"name": "shogi",
	"private": true,
	"license": "GPL-3.0-only",
	"type": "module",
	"imports": {
		"#/*": "./src/*"
	},
	"scripts": {
		"postinstall": "wrangler types",
		"dev": "vite dev --port 3160 --strictPort",
		"build": "vite build && node scripts/check-build.mjs",
		"preview": "vite preview --port 3161 --strictPort",
		"deploy": "pnpm run build && wrangler deploy",
		"typecheck": "tsc --noEmit",
		"test": "vitest run",
		"cf-typegen": "wrangler types"
	},
	"dependencies": {
		"@tailwindcss/vite": "^4.1.18",
		"@tanstack/react-router": "^1.170.39",
		"@tanstack/react-start": "^1.168.58",
		"react": "^19.2.0",
		"react-dom": "^19.2.0",
		"tailwindcss": "^4.1.18"
	},
	"devDependencies": {
		"@cloudflare/vite-plugin": "^1.26.0",
		"@cloudflare/vitest-plugin": "^1.2.8",
		"@types/node": "^22.10.2",
		"@types/react": "^19.2.0",
		"@types/react-dom": "^19.2.0",
		"@vitejs/plugin-react": "^6.0.1",
		"typescript": "^6.0.2",
		"vite": "^8.0.0",
		"vitest": "^4.1.0",
		"wrangler": "^4.141.0"
	},
	"pnpm": {
		"onlyBuiltDependencies": [
			"esbuild",
			"lightningcss",
			"sharp",
			"workerd"
		]
	}
}
